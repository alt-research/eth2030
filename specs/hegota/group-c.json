            "github.com/eth2030/eth2030/core/vm::TestFrameCSenderDefaultCodeCallException",
            "github.com/eth2030/eth2030/txpool::TestFrameCLocalPaymasterRequiresExplicitProfile"
          ],
          "scope": "selected profiles; public gates unchanged"
        }
      ]
    },
