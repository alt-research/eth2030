            "github.com/eth2030/eth2030/txpool::TestCanonicalFrame8141PoolRequiresOneCombinedApproval",
            "github.com/eth2030/eth2030/txpool::TestFrameCCaughtInvalidOpcodeCannotApprovePublicPrefix"
          ],
          "scope": "selected profiles; public gates unchanged"
        },
        {
          "id": "C20.4",
          "statement": "exact exceptions:** expiry TIMESTAMP only in its actual protocol frame/runtime context. Recent-root SLOTNUM and tuple-derived SLOAD only at top level, exact address and exact runtime, no nested permission. Canonical-paymaster exception requires an admitted exact template; generic noncanonical paymasters receive no trace exemption. Optimizations must match normal gas/receipts/warming and are optional.",
          "clauses": [
            "EIP-8141 Mempool/Behavior/Introspection",
            "EIP-8272 Public mempool handling"
          ],
          "files": [
            "pkg/core/types/frame_8141_pool.go",
            "pkg/core/vm/frame_8141.go",
            "pkg/core/execution/frame_8141.go"
